# ==========================
# Application
# ==========================
APP_NAME=Enterprise AI Knowledge Assistant
APP_ENV=development
DEBUG=true

# ==========================
# Server
# ==========================
HOST=127.0.0.1
PORT=8000

# ==========================
# Security
# ==========================
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================
# Database
# ==========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai_db

# ==========================
# Vector Database
# ==========================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ==========================
# Ollama
# ==========================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b


# ==========================
# RAG
# ==========================
RAG_RETRIEVAL_THRESHOLD=0.65
RAG_RELEVANCE_THRESHOLD=0.65

# ==========================
# Logging
# ==========================
LOG_LEVEL=INFO
